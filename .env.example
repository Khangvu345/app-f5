# Copy thành .env ở root repo trước khi chạy docker compose up. Không commit .env.
# DB_HOST/DB_PORT không cần ghi ở đây: Compose đã cố định backend kết nối db

DB_NAME=appdb
DB_USER=app
DB_PASSWORD=change-me-strong-password

# JWT: Có thể tạo bằng Git Bash: openssl rand -base64 48, rồi gắn vào JWT_SECRET. Thay giá trị mẫu này trước khi chạy lần đầu.
JWT_SECRET=change-me-to-a-secret-at-least-32-characters-long
JWT_ISSUER=app-backend
JWT_ACCESS_TOKEN_TTL=1h

# pgAdmin: tài khoản đăng nhập giao diện web pgAdmin, KHÁC với tài khoản database ở trên.
# Email phải đúng định dạng email
PGADMIN_EMAIL=admin@app.local
PGADMIN_PASSWORD=change-me-pgadmin-password
