# Copy this file to `.env` (same folder as build.gradle.kts). Never commit `.env`.
# Spring Boot loads it automatically when run from this folder (spring.config.import).

# --- Server ---
SERVER_PORT=8080

# --- PostgreSQL 18 (installed locally) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=app
DB_PASSWORD=change-me-strong-password

# --- JWT ---
# HS256 secret: at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=app-backend
# Access token lifetime (Spring Duration format: 30m, 1h, PT1H...)
JWT_ACCESS_TOKEN_TTL=1h
