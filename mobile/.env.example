# Copy this file to `.env` and adjust values. Never commit `.env`.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle,
# so NEVER put secrets here (they are readable by anyone who has the APK).

# Backend base URL (include the API prefix).
#  - Android emulator  -> http://10.0.2.2:8080/api/v1
#  - Physical device   -> http://<your-LAN-IP>:8080/api/v1
#  - Production        -> https://api.your-domain.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# development | staging | production
EXPO_PUBLIC_APP_ENV=development
